<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle's identity, in one file.

  The app-bundle pipeline (`app_bundle/`) reads this file rather than repeating
  any of it: the bundle's name, its executable and its identifier are decided
  here and nowhere else. Three values are load-bearing rather than decorative:

  * CFBundleIdentifier — ADR 0005: the microphone grant attaches to the bundle,
    so this string is what the grant belongs to. It names the *product*, not the
    component: "shell" was an internal name, and the person granting a microphone
    is granting it to GPT-VoiceCoding. Changing it re-prompts everyone who has
    already granted, so it was chosen once, at the last moment it was free.
  * NSMicrophoneUsageDescription — the sentence macOS shows when it asks. The
    TCC probe confirmed it is the *app's* string that appears, beside the app's
    own name; the bundled interpreter never does.
  * LSUIElement — menu bar only, no Dock icon. Launch at login means this, not a
    window.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>GPT-VoiceCoding</string>
	<key>CFBundleDisplayName</key>
	<string>GPT-VoiceCoding</string>
	<key>CFBundleIdentifier</key>
	<string>com.gptvoicecoding.GPT-VoiceCoding</string>
	<key>CFBundleExecutable</key>
	<string>GPTVoiceCodingShell</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>GPT-VoiceCoding uses the microphone for the Live Call it speaks and listens through.</string>
</dict>
</plist>
