<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle's identity, in one file.

  This is what #12 (the app bundle and signing pipeline) consumes or supersedes.
  Three values here are load-bearing rather than decorative:

  * CFBundleIdentifier — ADR 0005: the microphone grant attaches to the bundle,
    so this string is what the grant belongs to.
  * NSMicrophoneUsageDescription — the sentence macOS shows when it asks. The
    TCC probe confirmed it is the *app's* string that appears, beside the app's
    own name; the bundled interpreter never does.
  * LSUIElement — menu bar only, no Dock icon. Launch at login means this, not a
    window.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>GPT-VoiceCoding</string>
	<key>CFBundleDisplayName</key>
	<string>GPT-VoiceCoding</string>
	<key>CFBundleIdentifier</key>
	<string>com.gptvoicecoding.shell</string>
	<key>CFBundleExecutable</key>
	<string>GPTVoiceCodingShell</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>GPT-VoiceCoding uses the microphone for the Live Call it speaks and listens through.</string>
</dict>
</plist>
